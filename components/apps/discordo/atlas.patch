+package channelspicker
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/ayn2op/arikawa/v3/discord"
+	"github.com/ayn2op/discordo/internal/config"
+)
+
+func TestDecoratedNamesRemainSearchable(t *testing.T) {
+	m := &Model{cfg: &config.Config{}}
+	channel := discord.Channel{ID: 42, Type: discord.GuildText, Name: "📢│announcements"}
+	guild := discord.Guild{Name: "🌌 ATLAS"}
+	item := m.channelItem(nil, &guild, channel)
+	if item.Text != "announcements - ATLAS" || item.Reference != channel.ID {
+		t.Fatalf("unexpected display or identity: %+v", item)
+	}
+	if !strings.Contains(item.FilterText, channel.Name) || !strings.Contains(item.FilterText, guild.Name) {
+		t.Fatalf("original names missing from search: %q", item.FilterText)
+	}
+}
+
+func TestSymbolOnlyDMNameRemainsSearchable(t *testing.T) {
+	m := &Model{cfg: &config.Config{}}
+	channel := discord.Channel{ID: 42, Type: discord.DirectMessage,
+		DMRecipients: []discord.User{{ID: 9, Username: "🌌"}}}
+	item := m.channelItem(nil, nil, channel)
+	if item.Text != "Unnamed" || !strings.Contains(item.FilterText, "🌌") || item.Reference != channel.ID {
+		t.Fatalf("DM must retain original search and identity: %+v", item)
+	}
+}
