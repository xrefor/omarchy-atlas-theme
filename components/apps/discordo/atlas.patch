+func compactReplyPreview(value string, width int) string {
+	value = strings.Join(strings.Fields(value), " ")
+	if uniseg.StringWidth(value) <= width {
+		return value
+	}
+	var b strings.Builder
+	clusters := uniseg.NewGraphemes(value)
+	used := 0
+	for clusters.Next() {
+		if used+clusters.Width() > width-1 {
+			break
+		}
+		b.WriteString(clusters.Str())
+		used += clusters.Width()
+	}
+	return b.String() + "…"
