new file mode 100644
index 0000000000000000000000000000000000000000..227d38e768ef58c0423cfdcab215fbfa05f97863
--- /dev/null
+++ b/internal/ui/list_label.go
@@ -0,0 +1,36 @@
+package ui
+
+import (
+	"strings"
+	"unicode"
+
+	"github.com/rivo/uniseg"
+)
+
+// ListLabel removes decorative symbols from local navigation labels. Work on
+// grapheme clusters so emoji modifiers, flags and joined emoji disappear together,
+// while accented letters and non-Latin names remain intact. Discord's names and
+// IDs are never changed; this is only a presentation helper.
+func ListLabel(name string) string {
+	var out strings.Builder
+	clusters := uniseg.NewGraphemes(name)
+	for clusters.Next() {
+		cluster := clusters.Str()
+		decorative := false
+		for _, r := range cluster {
+			if unicode.Is(unicode.So, r) || unicode.Is(unicode.Co, r) || r == '\u20e3' {
+				decorative = true
+				break
+			}
+		}
+		if !decorative {
+			out.WriteString(cluster)
+		}
+	}
+	label := strings.Join(strings.Fields(out.String()), " ")
+	label = strings.Trim(label, " |｜·•‐‑–—-")
+	if label == "" {
+		return "Unnamed"
+	}
+	return label
+}
