+package ui
+
+import (
+	"testing"
+
+	"github.com/ayn2op/arikawa/v3/discord"
+	"github.com/ayn2op/discordo/internal/config"
+)
+
+func TestListLabel(t *testing.T) {
+	for _, tc := range []struct{ name, want string }{
+		{"📢│announcements", "announcements"},
+		{"✅ Rules and Welcome", "Rules and Welcome"},
+		{"👩🏽‍💻-developers", "developers"},
+		{"🇳🇴 Norsk", "Norsk"},
+		{"1️⃣ general", "general"},
+		{"\uf120 terminal", "terminal"},
+		{"⭐ EVE 🌌 Frontier ⭐", "EVE Frontier"},
+		{"Café — blåbær 日本語 العربية", "Café — blåbær 日本語 العربية"},
+		{"Cafe\u0301", "Cafe\u0301"},
+		{"/r/starcitizen", "/r/starcitizen"},
+		{"node.js / C++ / #help", "node.js / C++ / #help"},
+		{"support-and-help", "support-and-help"},
+		{"🔒", "Unnamed"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := ListLabel(tc.name); got != tc.want {
+				t.Fatalf("ListLabel(%q) = %q, want %q", tc.name, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestChannelLabelDoesNotChangeDiscordData(t *testing.T) {
+	channel := discord.Channel{ID: 42, Type: discord.GuildText, Name: "📢│announcements"}
+	if got := ChannelToString(channel, config.Icons{}, nil); got != "announcements" {
+		t.Fatalf("channel label = %q", got)
+	}
+	if channel.ID != 42 || channel.Name != "📢│announcements" {
+		t.Fatal("display formatting changed channel data")
+	}
+}
