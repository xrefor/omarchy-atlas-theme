--- /dev/null
+++ b/internal/markdown/link_label.go
@@ -0,0 +1,42 @@
+package markdown
+
+import (
+	"net/url"
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// compactLinkLabel shortens long automatic web links while retaining the full
+// destination in the rendered segment's URL metadata. Keep the entire host
+// visible, and do not rewrite non-web or userinfo-bearing URLs.
+func compactLinkLabel(raw string) string {
+	const limit = 56
+	if uniseg.StringWidth(raw) <= limit {
+		return raw
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Host == "" || u.User != nil || (u.Scheme != "http" && u.Scheme != "https") {
+		return raw
+	}
+	label := u.Host + u.EscapedPath()
+	if u.RawQuery != "" || u.Fragment != "" {
+		label += "…"
+	}
+	if uniseg.StringWidth(label) <= limit {
+		return label
+	}
+	// Never truncate the host. Only elide the path after it.
+	remaining := max(limit-uniseg.StringWidth(u.Host)-1, 0)
+	var path strings.Builder
+	clusters := uniseg.NewGraphemes(u.EscapedPath())
+	for clusters.Next() {
+		width := uniseg.StringWidth(clusters.Str())
+		if width > remaining {
+			break
+		}
+		path.WriteString(clusters.Str())
+		remaining -= width
+	}
+	return u.Host + path.String() + "…"
+}
