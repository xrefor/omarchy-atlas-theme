@@ -0,0 +1,163 @@
+package chat
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/ayn2op/arikawa/v3/discord"
+	"github.com/ayn2op/discordo/internal/config"
+	"github.com/ayn2op/tview/text"
+	"github.com/gdamore/tcell/v3"
+)
+
+func presentationList(t *testing.T) *messagesList {
+	t.Helper()
+	cfg, err := config.Load(filepath.Join(t.TempDir(), "config.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.HideBlockedUsers = false
+	cfg.DateSeparator.Enabled = false
+	cfg.Timestamps.Format = "15:04"
+	cfg.Theme.Footer.NormalStyle.Style = tcell.StyleDefault.Foreground(tcell.ColorGray)
+	cfg.Theme.MessagesList.AuthorStyle.Style = tcell.StyleDefault.Foreground(tcell.ColorWhite).Bold(true)
+	cfg.Theme.MessagesList.MessageStyle.Style = tcell.StyleDefault.Foreground(tcell.ColorSilver)
+	cfg.Theme.MessagesList.SelectedMessageStyle.Style = tcell.StyleDefault.Foreground(tcell.ColorOrange).Background(tcell.ColorBlack).Bold(true)
+	cfg.Theme.Border.NormalStyle.Style = tcell.StyleDefault.Foreground(tcell.ColorGray)
+	ml := NewModel(cfg, "").messagesList
+	ml.SetRect(0, 0, 80, 30)
+	return ml
+}
+
+func lineText(line text.Line) string {
+	var b strings.Builder
+	for _, segment := range line {
+		b.WriteString(segment.Text)
+	}
+	return b.String()
+}
+
+func TestChatHeaderBodyAndSpacing(t *testing.T) {
+	ml := presentationList(t)
+	message := discord.Message{
+		Author: discord.User{Username: "Ada"}, Content: "first line\nsecond line",
+		Timestamp:       discord.Timestamp(time.Date(2026, 9, 19, 12, 34, 0, 0, time.Local)),
+		EditedTimestamp: discord.Timestamp(time.Now()),
+	}
+	content := ml.renderMessage(message, ml.cfg.Theme.MessagesList.MessageStyle.Style)
+	if len(content) != 4 || lineText(content[0]) != "Ada  12:34  edited" || lineText(content[1]) != "first line" || lineText(content[2]) != "second line" || len(content[3]) != 0 {
+		t.Fatalf("unexpected header/body/spacing: %#v", content)
+	}
+	for _, segment := range content[0] {
+		if strings.Contains(segment.Text, "12:34") || strings.Contains(segment.Text, "edited") {
+			if segment.Style.GetForeground() != tcell.ColorGray || segment.Style.HasDim() {
+				t.Errorf("metadata is not readable secondary text: %v", segment)
+			}
+		}
+	}
+}
+
+func TestAuthorThemeOverridesRoleColor(t *testing.T) {
+	ml := presentationList(t)
+	message := discord.Message{GuildID: 1, Author: discord.User{ID: 2, Username: "Ada"}}
+	if err := ml.chat.state.Cabinet.MemberSet(1, &discord.Member{User: message.Author, Nick: "Ada Lovelace", RoleIDs: []discord.RoleID{3}}, false); err != nil {
+		t.Fatal(err)
+	}
+	if err := ml.chat.state.Cabinet.RoleSet(1, &discord.Role{ID: 3, Color: 0xffff00, Position: 1}, false); err != nil {
+		t.Fatal(err)
+	}
+	for _, configured := range []bool{true, false} {
+		want := tcell.ColorWhite
+		if !configured {
+			ml.cfg.Theme.MessagesList.AuthorStyle.Style = tcell.StyleDefault
+			want = tcell.NewHexColor(0xffff00)
+		}
+		builder := new(text.Builder)
+		ml.drawAuthor(builder, message, tcell.StyleDefault)
+		line := builder.Finish()[0]
+		if lineText(line) != "Ada Lovelace" || line[0].Style.GetForeground() != want {
+			t.Fatalf("configured=%v: author = %v, want nickname with %v", configured, line, want)
+		}
+	}
+}
+
+func TestAttachmentFilenameRetainsLinkTarget(t *testing.T) {
+	ml := presentationList(t)
+	ml.cfg.ShowAttachmentLinks = false
+	attachment := discord.Attachment{Filename: "report.pdf", URL: "https://cdn.example.test/report.pdf?signature=very-long"}
+	content := ml.renderMessage(discord.Message{Author: discord.User{Username: "Ada"}, Attachments: []discord.Attachment{attachment}}, tcell.StyleDefault)
+	count := 0
+	for _, line := range content {
+		for _, segment := range line {
+			if strings.Contains(segment.Text, attachment.URL) {
+				t.Fatal("attachment URL was rendered as text")
+			}
+			if segment.Text == attachment.Filename {
+				count++
+				if _, target := segment.Style.GetUrl(); target != attachment.URL {
+					t.Fatalf("filename target = %q", target)
+				}
+			}
+		}
+	}
+	if count != 1 {
+		t.Fatalf("filename appeared %d times", count)
+	}
+}
+
+func TestReplyPreviewFitsAndPreservesReference(t *testing.T) {
+	ml := presentationList(t)
+	ml.SetRect(0, 0, 32, 20)
+	original := &discord.Message{ID: 10, Author: discord.User{Username: "Ada"}, Content: strings.Repeat("日本語 long text\n", 12)}
+	message := discord.Message{ID: 11, Type: discord.InlinedReplyMessage, Author: discord.User{Username: "Grace"}, ReferencedMessage: original, Content: "reply body"}
+	content := ml.renderMessage(message, tcell.StyleDefault)
+	_, _, width, _ := ml.InnerRect()
+	if len(content) != 4 || content[0].Width() >= width || !strings.HasSuffix(lineText(content[0]), "…") || lineText(content[2]) != "reply body" {
+		t.Fatalf("preview/body layout = %#v", content)
+	}
+	if message.ReferencedMessage != original || original.ID != 10 || original.GuildID != 0 || !strings.Contains(original.Content, "\n") {
+		t.Fatal("preview mutated the referenced message")
+	}
+}
+
+func TestChatSelectionAndResizePreserveMessageIdentity(t *testing.T) {
+	ml := presentationList(t)
+	configured := ml.cfg.Theme.MessagesList.SelectedMessageStyle.Style
+	selected := chatSelectionStyle(ml.cfg)
+	if selected.GetForeground() != ml.cfg.Theme.MessagesList.MessageStyle.Style.GetForeground() || selected.GetBackground() != configured.GetBackground() || selected.HasBold() || ml.cfg.Theme.MessagesList.SelectedMessageStyle.Style != configured {
+		t.Fatal("chat selection lost body color, selection background, or mutated shared theme")
+	}
+	ml.setMessages([]discord.Message{{ID: 5, Content: "body"}})
+	ml.SetCursor(0)
+	view := ml.buildItem(0)
+	ml.SetRect(0, 0, 80, 40)
+	if ml.buildItem(0) != view {
+		t.Fatal("height-only resize discarded cached message")
+	}
+	ml.SetRect(0, 0, 40, 40)
+	if ml.buildItem(0) == view {
+		t.Fatal("width resize retained a stale wrapped preview")
+	}
+	if message, ok := ml.selectedMessage(); !ok || message.ID != 5 {
+		t.Fatal("resize changed the selected message")
+	}
+}
+
+func TestEmbedBarUsesThemeOutline(t *testing.T) {
+	ml := presentationList(t)
+	message := discord.Message{Author: discord.User{Username: "Ada"}, Embeds: []discord.Embed{{Title: "Release notes", Color: 0xffff00}}}
+	content := ml.renderMessage(message, tcell.StyleDefault)
+	for _, line := range content {
+		for _, segment := range line {
+			if strings.Contains(segment.Text, "▎") {
+				if segment.Style.GetForeground() != tcell.ColorGray {
+					t.Fatalf("embed bar uses Discord color: %v", segment.Style)
+				}
+				return
+			}
+		}
+	}
+	t.Fatal("embed bar missing")
+}
