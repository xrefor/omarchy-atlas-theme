@@ -0,0 +1,43 @@
+package markdown
+
+import (
+	"strings"
+	"testing"
+
+	md "github.com/ayn2op/arikawa/v3/markdown"
+	"github.com/ayn2op/discordo/internal/config"
+	"github.com/gdamore/tcell/v3"
+)
+
+func TestCompactLinkRetainsDestination(t *testing.T) {
+	raw := "https://example.org/files/report?signature=" + strings.Repeat("a", 120)
+	source := []byte(raw)
+	rendered := NewRenderer(&config.Config{}).RenderText(source, md.Parse(source), tcell.StyleDefault)
+	var found bool
+	for _, line := range rendered {
+		for _, segment := range line {
+			if _, target := segment.Style.GetUrl(); target != raw {
+				continue
+			}
+			found = true
+			if segment.Text != "example.org/files/report…" {
+				t.Fatalf("unexpected compact label: %q", segment.Text)
+			}
+		}
+	}
+	if !found {
+		t.Fatal("full clickable destination was lost")
+	}
+}
+
+func TestCompactLinkPreservesHostAndSpecialURLs(t *testing.T) {
+	for _, raw := range []string{"https://example.org", "mailto:" + strings.Repeat("a", 60) + "@" + "example.org", "https://example-user@" + "example.org/" + strings.Repeat("a", 90)} {
+		if got := compactLinkLabel(raw); got != raw {
+			t.Fatalf("rewrote short or special URL: %q", got)
+		}
+	}
+	host := strings.Repeat("a", 60) + ".example.org:8080"
+	if got := compactLinkLabel("https://" + host + "/a/long/path"); got != host+"…" {
+		t.Fatalf("host was shortened: %q", got)
+	}
+}
