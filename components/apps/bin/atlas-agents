#!/usr/bin/env python3
"""Open the ATLAS agent observer from a checkout or installed runtime."""
from pathlib import Path
import sys

source = Path(__file__).resolve().parents[1]
if not (source / 'atlas_agents').is_dir():
    source = Path.home() / '.local/share/atlas/components/apps'
sys.path.insert(0, str(source))
from atlas_agents.__main__ import main

if __name__ == '__main__':
    raise SystemExit(main())
