#!/usr/bin/env python3
"""Theme human-readable tcpdump output while preserving capture modes."""

from __future__ import annotations

import os
from pathlib import Path
import signal
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/atlas-cli"))
from atlas_cli.palette import load_theme, want_color
from atlas_cli.runner import colorize

REAL = "/usr/bin/tcpdump"


def parse_wrapper_args(argv: list[str]) -> tuple[str, list[str]]:
    mode = os.environ.get("ATLAS_COLOR", os.environ.get("TCPDUMP_COLOR", "auto"))
    output = []
    for arg in argv:
        if arg in ("--no-color", "--color=never"):
            mode = "never"
        elif arg in ("--color", "--color=always"):
            mode = "always"
        elif arg == "--color=auto":
            mode = "auto"
        elif arg.startswith("--color="):
            mode = "auto"
        else:
            output.append(arg)
    return mode, output


def scan_tcpdump_args(argv: list[str]) -> dict[str, bool]:
    info = {
        "write": False,
        "print": False,
        "read": False,
        "help": False,
        "version": False,
        "has_l": False,
    }
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            break
        if arg in ("-h", "--help"):
            info["help"] = True
        elif arg == "--version":
            info["version"] = True
        elif arg == "--print":
            info["print"] = True
        elif arg == "-r":
            info["read"] = True
            index += 1
        elif arg.startswith("-r") and len(arg) > 2 and not arg.startswith("-r-"):
            info["read"] = True
        elif arg == "-w":
            info["write"] = True
            index += 1
        elif arg.startswith("-w") and len(arg) > 2 and not arg.startswith("-w-"):
            info["write"] = True
        elif arg == "-l":
            info["has_l"] = True
        elif arg.startswith("-") and not arg.startswith("--"):
            flags = arg[1:]
            info["has_l"] |= "l" in flags
            info["read"] |= "r" in flags
            info["write"] |= "w" in flags
        index += 1
    return info


def needs_privileges(info: dict[str, bool]) -> bool:
    return os.geteuid() != 0 and not (info["help"] or info["version"] or info["read"])


def privileged_command(argv: list[str], info: dict[str, bool]) -> list[str]:
    command = [REAL, *argv]
    if needs_privileges(info):
        return (["sudo"] if sys.stdin.isatty() else ["sudo", "-A"]) + command
    return command


def run_passthrough(argv: list[str], info: dict[str, bool]) -> int:
    command = privileged_command(argv, info)
    os.execvp(command[0], command)
    return 1


def run_colored(argv: list[str], info: dict[str, bool]) -> int:
    args = list(argv)
    if not info["has_l"]:
        args.insert(0, "-l")
    process = subprocess.Popen(
        privileged_command(args, info),
        stdout=subprocess.PIPE,
        stderr=None,
        text=True,
        bufsize=1,
    )
    handlers = {}

    def forward(signum, _frame):
        if process.poll() is None:
            try:
                process.send_signal(signum)
            except ProcessLookupError:
                pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        handlers[signum] = signal.signal(signum, forward)
    colors = load_theme()
    try:
        assert process.stdout is not None
        for line in process.stdout:
            sys.stdout.write(colorize("tcpdump", line, colors))
            sys.stdout.flush()
    except BrokenPipeError:
        process.terminate()
    finally:
        if process.stdout is not None:
            process.stdout.close()
        code = process.wait()
        for signum, handler in handlers.items():
            signal.signal(signum, handler)
    if code < 0:
        signum = -code
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
    return code


def main() -> int:
    mode, argv = parse_wrapper_args(sys.argv[1:])
    info = scan_tcpdump_args(argv)
    if not os.path.exists(REAL):
        print("tcpdump: /usr/bin/tcpdump not found", file=sys.stderr)
        return 127
    color = want_color(mode)
    if info["help"] or info["version"] or (info["write"] and not info["print"]):
        color = False
    return run_colored(argv, info) if color else run_passthrough(argv, info)


if __name__ == "__main__":
    raise SystemExit(main())
