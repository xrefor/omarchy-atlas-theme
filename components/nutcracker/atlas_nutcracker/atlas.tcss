Screen { background: #100e0c; color: #d6cfc4; }
#brand { height: 2; margin: 1 2 0 2; }
#subtitle { height: 1; color: #6e675c; margin: 0 2 1 2; }
TabbedContent { height: 1fr; margin: 0 2; }
TabPane { padding: 1 0; }
Tabs { background: #100e0c; }
Tab { color: #a69b8c; background: #100e0c; }
Tab.-active { color: #f2ebe0; text-style: bold; }
Underline > .underline--bar { color: #ff5a12; }
.section-title { height: 1; color: #f2ebe0; text-style: bold; border-left: solid #ff5a12; padding-left: 1; margin-bottom: 1; }
#file-row { height: 3; }
Input { background: #100e0c; border: solid #3a342c; padding: 0 1; }
Input:focus { border: solid #ff5a12; }
#apk { width: 1fr; }
Button { background: #100e0c; color: #f2ebe0; border: solid #3a342c; min-width: 12; margin-left: 1; }
Button:hover { background: #1c1814; border: solid #a69b8c; }
Button:focus { border: solid #ff5a12; text-style: none; }
Button.-primary { color: #f2ebe0; background: #100e0c; border: solid #ff5a12; text-style: bold; }
Button.-primary:hover { color: #f2ebe0; background: #100e0c; border: solid #ff7438; }
Button:disabled { opacity: 40%; }
#scope { height: 2; padding-top: 1; color: #6e675c; }
.actions { height: 3; margin: 1 0; }
.actions Button:first-child { margin-left: 0; }
#status { width: 1fr; padding: 1 2; color: #f2ebe0; }
#output { height: 1fr; min-height: 4; background: #100e0c; border: solid #3a342c; padding: 0 1; border-title-color: #ff5a12; }
DataTable { background: #100e0c; height: 1fr; }
DataTable > .datatable--header { background: #1c1814; color: #f2ebe0; text-style: none; }
DataTable > .datatable--cursor { background: #2a160c; color: #ff5a12; }
DataTable > .datatable--hover { background: #1c1814; }
#tools { height: 12; }
#details { height: 1fr; color: #a69b8c; }
#details Static { height: auto; margin-bottom: 1; }
#config-path, #data-path { color: #6e675c; }
.hint { padding: 1 2; color: #6e675c; }
Footer { background: #1c1814; color: #a69b8c; }
Footer > .footer--key { color: #ff5a12; background: #1c1814; }
FilePicker { align: center middle; background: #050403 80%; }
#picker { width: 80%; height: 80%; background: #100e0c; border: solid #3a342c; padding: 1 2; }
#file-tree { height: 1fr; margin: 1 0; background: #100e0c; }
